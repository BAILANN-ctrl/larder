# Server
PORT=4000

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/larder"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=your_stripe_test_secret_key
STRIPE_PRICE_ID=your_stripe_test_price_id
STRIPE_WEBHOOK_SECRET=webhook_secret

# Frontend origin for CORS + Stripe redirect URLs
FRONTEND_URL=http://localhost:3000
